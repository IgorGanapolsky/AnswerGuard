<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access for analytics and future signed spam intelligence updates. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- In-App Billing for Pro upgrade -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Allow identification of contacts to avoid blocking them -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- SMS permission for premium caller identification -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Remove AD_ID permission added by dependencies (Firebase/PostHog) — app does not use advertising ID -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <application
        android:name=".AnswerGuardApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.AnswerGuard"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/launcher_label"
            android:theme="@style/Theme.AnswerGuard"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link for UTM attribution tracking -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="igorganapolsky.github.io"
                    android:pathPrefix="/AnswerGuard" />
            </intent-filter>

            <!-- Custom URL scheme for campaign tracking -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="answerguard" android:host="open" />
            </intent-filter>
        </activity>

        <!-- Disable Sentry auto-init to prevent crash without DSN -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />

        <!-- Call Screening Service -->
        <service
            android:name=".screening.AnswerGuardScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Role onboarding transparent activity -->
        <activity
            android:name=".screening.RoleOnboardingActivity"
            android:theme="@style/Theme.Transparent"
            android:exported="false" />

        <!-- SMS Receiver for Pro SMS caller identification -->
        <receiver
            android:name=".screening.SmsReceiver"
            android:permission="android.permission.BROADCAST_SMS"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
