<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access for analytics and future signed spam intelligence updates. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- In-App Billing for Pro upgrade -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Allow identification of contacts to avoid blocking them -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- See-all-calls: surface calls that AG's CallScreeningService never saw
         (DND-silenced, carrier spam-filtered, calls before AG was installed).
         Default-handler exception applies — AG is the default Caller ID & Spam app. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="com.android.voicemail.permission.READ_VOICEMAIL" />

    <!-- Remove AD_ID permission added by dependencies (Firebase/PostHog) — app does not use advertising ID -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <!-- Remove REQUEST_INSTALL_PACKAGES permission added by Firebase App Distribution.
         Play Console flags this permission as needing a "permitted-use category"
         declaration that AnswerGuard does not match (no app-installer/store/browser
         core purpose). Internal tester delivery is moving to the Play Console
         Internal Testing track (see docs/INTERNAL_TESTING.md), so FAD self-update
         is no longer needed. Side effect: FirebaseAppDistribution.updateIfNewReleaseAvailable()
         in MainActivity.kt will fail silently (already has addOnFailureListener noop). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />

    <application
        android:name=".AnswerGuardApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.AnswerGuard"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/launcher_label"
            android:theme="@style/Theme.AnswerGuard"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link for UTM attribution tracking -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="igorganapolsky.github.io"
                    android:pathPrefix="/AnswerGuard" />
            </intent-filter>

            <!-- Custom URL scheme for campaign tracking -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="answerguard" android:host="open" />
            </intent-filter>
        </activity>

        <!-- Disable Sentry auto-init to prevent crash without DSN -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />

        <!-- Call Screening Service -->
        <service
            android:name=".screening.AnswerGuardScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Role onboarding transparent activity -->
        <activity
            android:name=".screening.RoleOnboardingActivity"
            android:theme="@style/Theme.Transparent"
            android:exported="false" />

    </application>

</manifest>
