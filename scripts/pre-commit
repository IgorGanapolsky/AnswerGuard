#!/usr/bin/env bash
# AnswerGuard pre-commit hook: secrets, architecture guardrails, and legacy surface bans.
set -euo pipefail

ERRORS=0
WARNINGS=0

err() { echo "ERROR: $1"; ERRORS=$((ERRORS + 1)); }
warn() { echo "WARN: $1"; WARNINGS=$((WARNINGS + 1)); }

if command -v gitleaks > /dev/null 2>&1; then
  if ! gitleaks git --pre-commit --staged --no-banner 2>/dev/null; then
    err "Secrets detected in staged files."
    exit 1
  fi
else
  STAGED_DIFF=$(git diff --cached --diff-filter=ACM)
  if echo "$STAGED_DIFF" | grep -qEi '(ghp_|gho_|github_pat_|sk-[a-zA-Z0-9]{20,}|AKIA[0-9A-Z]{16}|password\s*=\s*["\x27][^"\x27]{8,})'; then
    err "Possible secret detected in staged changes."
  fi
fi

STAGED_KT=$(git diff --cached --name-only --diff-filter=ACM | grep '\.kt$' || true)
STAGED_SWIFT=$(git diff --cached --name-only --diff-filter=ACM | grep '\.swift$' || true)
STAGED_APP_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(native-android/app/src/main|native-ios/AnswerGuard|native-ios/CallDirectoryExtension|\.maestro)/' || true)

if [ -n "$STAGED_KT" ]; then
  while IFS= read -r file; do
    [ -f "$file" ] || continue

    if grep -n 'AndroidViewModel' "$file" | grep -v '// allow-android-viewmodel' > /dev/null 2>&1; then
      err "$file uses AndroidViewModel; use ViewModel with injected dependencies."
    fi
    if grep -n '\.collectAsState()' "$file" > /dev/null 2>&1; then
      err "$file uses collectAsState(); use collectAsStateWithLifecycle()."
    fi
    if grep -n 'Handler(Looper' "$file" | grep -v '// allow-handler' > /dev/null 2>&1; then
      err "$file uses Handler(Looper); prefer coroutines."
    fi
  done <<< "$STAGED_KT"

  if command -v trunk > /dev/null 2>&1; then
    echo "$STAGED_KT" | xargs trunk check --no-progress --filter=ktlint 2>/dev/null || ERRORS=$((ERRORS + 1))
  fi
fi

if [ -n "$STAGED_SWIFT" ]; then
  while IFS= read -r file; do
    [ -f "$file" ] || continue

    if echo "$file" | grep -qvE '(Tests|Preview)' && grep -n 'print(' "$file" | grep -v '// allow-print' > /dev/null 2>&1; then
      warn "$file uses print(); prefer Logger."
    fi
    if grep -n 'AudioServicesPlaySystemSound\|kSystemSoundID_Vibrate' "$file" > /dev/null 2>&1; then
      err "$file uses deprecated vibration/audio APIs."
    fi
  done <<< "$STAGED_SWIFT"

  if command -v swiftlint > /dev/null 2>&1; then
    echo "$STAGED_SWIFT" | xargs swiftlint lint --strict --quiet 2>/dev/null || ERRORS=$((ERRORS + 1))
  fi
fi

if [ -n "$STAGED_APP_FILES" ]; then
  LEGACY_PATTERN='Random Timer|Random-Timer|TimerForegroundService|TimerSetupScreen|ActiveTimerScreen|TimerManager|TimerConfig|TimerState|CircularTimer|USE_EXACT_ALARM|SCHEDULE_EXACT_ALARM|FOREGROUND_SERVICE_SPECIAL_USE|timer_started|timer_completed|timer_abandoned|Start Timer|Time'\''s Up'
  while IFS= read -r file; do
    [ -f "$file" ] || continue
    if grep -nE "$LEGACY_PATTERN" "$file" > /dev/null 2>&1; then
      err "$file contains legacy Random Timer surface."
    fi
  done <<< "$STAGED_APP_FILES"
fi

if [ "$ERRORS" -gt 0 ]; then
  echo "Pre-commit: $ERRORS error(s), $WARNINGS warning(s)."
  exit 1
fi

if [ "$WARNINGS" -gt 0 ]; then
  echo "Pre-commit: $WARNINGS warning(s)."
fi
