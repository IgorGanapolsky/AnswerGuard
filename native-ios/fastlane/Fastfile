default_platform(:ios)

platform :ios do
  def screenshot_delete_submit_lock_error?(error)
    msg = error.to_s
    return true if msg.include?("Can't Delete Screenshot After Submit for review")
    return true if msg.include?("Failed verification of all screenshots deleted")
    false
  end

  def duplicate_testflight_build_error?(error)
    msg = error.to_s
    return true if msg.include?("bundle version must be higher than the previously uploaded version")
    return true if msg.include?("value that has already been used")
    return true if msg.include?("Redundant Binary Upload")
    return true if msg.include?("You've already uploaded a build with build number")
    return true if msg.include?("already exists")
    false
  end

  def testflight_upload_options(api_key)
    options = {
      skip_waiting_for_build_processing: false,
      api_key: api_key
    }

    distribute_external = ENV.fetch("TESTFLIGHT_DISTRIBUTE_EXTERNAL", "false") == "true"
    return options unless distribute_external

    group_names = ENV.fetch("TESTFLIGHT_GROUPS", "").split(",").map(&:strip).reject(&:empty?)
    UI.user_error!("TESTFLIGHT_GROUPS required when TESTFLIGHT_DISTRIBUTE_EXTERNAL=true") if group_names.empty?

    options[:groups] = group_names
    options[:distribute_external] = true
    options[:notify_external_testers] = ENV.fetch("TESTFLIGHT_NOTIFY_EXTERNAL_TESTERS", "false") == "true"
    options[:changelog] = ENV.fetch("TESTFLIGHT_CHANGELOG", "Internal build from #{ENV.fetch('GITHUB_SHA', 'local')[0..7]}")
    options
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"] == "true"

    # Use App Store Connect API key if available
    if ENV["APPSTORE_KEY_ID"] && ENV["APPSTORE_ISSUER_ID"]
      api_key = app_store_connect_api_key(
        key_id: ENV["APPSTORE_KEY_ID"],
        issuer_id: ENV["APPSTORE_ISSUER_ID"],
        key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['APPSTORE_KEY_ID']}.p8")
      )
    end

    marketing_version = get_version_number(
      xcodeproj: "AnswerGuard.xcodeproj",
      target: "AnswerGuard"
    )
    current_build_number = get_build_number(
      xcodeproj: "AnswerGuard.xcodeproj"
    ).to_i
    next_build_number = current_build_number + 1

    if defined?(api_key)
      begin
        latest_remote_build_number = latest_testflight_build_number(
          api_key: api_key,
          app_identifier: "com.igorganapolsky.answerguard",
          version: marketing_version,
          initial_build_number: current_build_number
        ).to_i
        next_build_number = [next_build_number, latest_remote_build_number + 1].max
      rescue => e
        UI.important("Could not read latest TestFlight build number: #{e}")
      end
    end

    UI.message("Using build number #{next_build_number} for version #{marketing_version}")
    increment_build_number(
      xcodeproj: "AnswerGuard.xcodeproj",
      build_number: next_build_number
    )

    if ENV["CI"] == "true" && ENV["MATCH_GIT_URL"]
      # CI runners do not have Apple ID accounts configured; force manual signing
      # with match-managed App Store profiles for deterministic archives.
      match(
        type: "appstore",
        app_identifier: [
          "com.igorganapolsky.answerguard",
          "com.igorganapolsky.answerguard.widget",
          "com.igorganapolsky.answerguard.calldirectory"
        ],
        # With an App Store Connect API key available, run match read-write so
        # it can GENERATE any missing provisioning profile (e.g. the
        # calldirectory extension profile that was absent from the match repo
        # and silently blocked every iOS release since 2026-05-13)
        # non-interactively — no Apple ID 2FA.
        #
        # NB: use `api_key.nil?`, NOT `defined?(api_key)`. Ruby's parser marks
        # `api_key` as a declared local for the whole lane the moment the
        # `api_key = ...` assignment appears textually above — even when the
        # enclosing `if` didn't run — so `defined?(api_key)` is ALWAYS truthy
        # here and would force read-write mode even with no key. `api_key` is
        # nil when unassigned, so `.nil?` is the correct presence check.
        readonly: api_key.nil?,
        force_for_new_certificates: ENV["MATCH_FORCE_NEW_CERT"] == "true",
        api_key: api_key
      )

      app_profile = ENV["sigh_com.igorganapolsky.answerguard_appstore_profile-name"] ||
                    "match AppStore com.igorganapolsky.answerguard"
      widget_profile = ENV["sigh_com.igorganapolsky.answerguard.widget_appstore_profile-name"] ||
                       "match AppStore com.igorganapolsky.answerguard.widget"
      call_directory_profile = ENV["sigh_com.igorganapolsky.answerguard.calldirectory_appstore_profile-name"] ||
                               "match AppStore com.igorganapolsky.answerguard.calldirectory"

      update_code_signing_settings(
        path: "AnswerGuard.xcodeproj",
        use_automatic_signing: false,
        targets: ["AnswerGuard"],
        code_sign_identity: "Apple Distribution",
        profile_name: app_profile
      )

      update_code_signing_settings(
        path: "AnswerGuard.xcodeproj",
        use_automatic_signing: false,
        targets: ["AnswerGuardWidgetExtension"],
        code_sign_identity: "Apple Distribution",
        profile_name: widget_profile
      )

      update_code_signing_settings(
        path: "AnswerGuard.xcodeproj",
        use_automatic_signing: false,
        targets: ["CallDirectoryExtension"],
        code_sign_identity: "Apple Distribution",
        profile_name: call_directory_profile
      )

      build_opts = {
        scheme: "AnswerGuard",
        export_method: "app-store",
        output_directory: ".",
        output_name: "AnswerGuard",
        export_options: {
          signingStyle: "manual",
          provisioningProfiles: {
            "com.igorganapolsky.answerguard" => app_profile,
            "com.igorganapolsky.answerguard.widget" => widget_profile,
            "com.igorganapolsky.answerguard.calldirectory" => call_directory_profile
          }
        }
      }
      build_opts[:xcargs] = "POSTHOG_API_KEY=#{ENV['POSTHOG_API_KEY']}" unless ENV["POSTHOG_API_KEY"].to_s.empty?
      build_app(**build_opts)
    else
      # Local/dev fallback when match is not configured.
      posthog_xcargs = ENV["POSTHOG_API_KEY"].to_s.empty? ? "-allowProvisioningUpdates" : "-allowProvisioningUpdates POSTHOG_API_KEY=#{ENV['POSTHOG_API_KEY']}"
      build_app(
        scheme: "AnswerGuard",
        export_method: "app-store",
        output_directory: ".",
        output_name: "AnswerGuard",
        xcargs: posthog_xcargs
      )
    end

    testflight_api_key = defined?(api_key) ? api_key : nil
    upload_attempts = 0
    begin
      upload_to_testflight(**testflight_upload_options(testflight_api_key))
    rescue => e
      raise unless duplicate_testflight_build_error?(e)
      raise if upload_attempts >= 1 || !defined?(api_key)

      upload_attempts += 1
      latest_remote_build_number = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: "com.igorganapolsky.answerguard",
        version: marketing_version,
        initial_build_number: next_build_number
      ).to_i
      next_build_number = [next_build_number + 1, latest_remote_build_number + 1].max
      UI.important("Retrying TestFlight upload with build #{next_build_number} after duplicate build rejection.")
      increment_build_number(
        xcodeproj: "AnswerGuard.xcodeproj",
        build_number: next_build_number
      )

      if ENV["CI"] == "true" && ENV["MATCH_GIT_URL"]
        build_opts = {
          scheme: "AnswerGuard",
          export_method: "app-store",
          output_directory: ".",
          output_name: "AnswerGuard",
          export_options: {
            signingStyle: "manual",
            provisioningProfiles: {
              "com.igorganapolsky.answerguard" => app_profile,
              "com.igorganapolsky.answerguard.widget" => widget_profile,
              "com.igorganapolsky.answerguard.calldirectory" => call_directory_profile
            }
          }
        }
        build_opts[:xcargs] = "POSTHOG_API_KEY=#{ENV['POSTHOG_API_KEY']}" unless ENV["POSTHOG_API_KEY"].to_s.empty?
        build_app(**build_opts)
      else
        posthog_xcargs = ENV["POSTHOG_API_KEY"].to_s.empty? ? "-allowProvisioningUpdates" : "-allowProvisioningUpdates POSTHOG_API_KEY=#{ENV['POSTHOG_API_KEY']}"
        build_app(
          scheme: "AnswerGuard",
          export_method: "app-store",
          output_directory: ".",
          output_name: "AnswerGuard",
          xcargs: posthog_xcargs
        )
      end

      retry
    end
  end

  desc "Create app in App Store Connect"
  lane :create_app do |options|
    produce(
      app_identifier: "com.igorganapolsky.answerguard",
      app_name: "AnswerGuard",
      language: "en-US",
      app_version: options[:version] || get_version_number(xcodeproj: "AnswerGuard.xcodeproj", target: "AnswerGuard"),
      sku: "answerguard001",
      team_id: ENV["FASTLANE_TEAM_ID"]
    )
  end

  desc "Upload metadata (screenshots, descriptions) to App Store Connect"
  lane :metadata do |options|
    if ENV["APPSTORE_KEY_ID"] && ENV["APPSTORE_ISSUER_ID"]
      api_key = app_store_connect_api_key(
        key_id: ENV["APPSTORE_KEY_ID"],
        issuer_id: ENV["APPSTORE_ISSUER_ID"],
        key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['APPSTORE_KEY_ID']}.p8")
      )
    end

    use_live_raw = options.key?(:use_live_version) ? options[:use_live_version] : false
    use_live_version = [true, "true", "1", 1, "yes", "on"].include?(use_live_raw)

    version = options[:version] || get_version_number(xcodeproj: "AnswerGuard.xcodeproj", target: "AnswerGuard")
    if use_live_version
      UI.message("Running metadata sync against live App Store version (version hint v#{version})")
    else
      UI.message("Running metadata sync for App Store version v#{version}")
    end

    deliver_args = {
      app_identifier: "com.igorganapolsky.answerguard",
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: false,
      overwrite_screenshots: true,
      # Fastlane precheck can't validate IAP via App Store Connect API keys and will fail the lane.
      # We do our own hard preflight checks before submission (see scripts/asc_submit_for_review.py).
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      # When targeting live version, avoid mutating versionString.
      skip_app_version_update: use_live_version,
      use_live_version: use_live_version,
      force: true,
      api_key: defined?(api_key) ? api_key : nil
    }
    deliver_args[:app_version] = version unless use_live_version
    begin
      deliver(deliver_args)
    rescue => e
      raise unless screenshot_delete_submit_lock_error?(e)
      UI.important("ASC screenshot deletion is locked after submit-for-review; retrying metadata lane with screenshots skipped.")
      fallback_args = deliver_args.merge(
        skip_screenshots: true,
        overwrite_screenshots: false
      )
      deliver(fallback_args)
    end
  end

  desc "Submit a given version for App Review (uploads metadata + attaches build)"
  lane :submit_review do |options|
    setup_ci if ENV["CI"] == "true"

    if ENV["APPSTORE_KEY_ID"] && ENV["APPSTORE_ISSUER_ID"]
      api_key = app_store_connect_api_key(
        key_id: ENV["APPSTORE_KEY_ID"],
        issuer_id: ENV["APPSTORE_ISSUER_ID"],
        key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['APPSTORE_KEY_ID']}.p8")
      )
    end

    version = options[:version] || get_version_number(xcodeproj: "AnswerGuard.xcodeproj", target: "AnswerGuard")
    build_number = options[:build_number]

    if (build_number.nil? || build_number.to_s.strip.empty?) && defined?(api_key)
      begin
        build_number = latest_testflight_build_number(
          api_key: api_key,
          app_identifier: "com.igorganapolsky.answerguard",
          version: version
        )
      rescue => e
        UI.user_error!("Could not determine latest TestFlight build number for v#{version}: #{e}")
      end
    end

    if build_number.nil? || build_number.to_s.strip.empty?
      UI.user_error!("Missing build_number. Provide build_number:<N> or ensure APPSTORE_* API key env vars are configured.")
    end

    UI.message("Submitting App Store version v#{version} with build #{build_number} for review")

    deliver(
      app_identifier: "com.igorganapolsky.answerguard",
      app_version: version,
      build_number: build_number.to_s,
      submit_for_review: true,
      automatic_release: false,
      skip_binary_upload: true,
      # Fastlane precheck can't validate IAP via App Store Connect API keys and will fail the lane.
      # We do our own hard preflight checks before submission (see scripts/asc_submit_for_review.py).
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      # Prefer uploading screenshots/metadata in the separate `metadata` lane,
      # then submit with a minimal, deterministic step.
      skip_screenshots: options.key?(:skip_screenshots) ? options[:skip_screenshots] : true,
      skip_metadata: options.key?(:skip_metadata) ? options[:skip_metadata] : true,
      force: true,
      api_key: defined?(api_key) ? api_key : nil,
      submission_information: {
        export_compliance_uses_encryption: false,
        export_compliance_encryption_updated: false
      }
    )
  end

  desc "Verify build processed on TestFlight"
  lane :verify do |options|
    version = options[:version] || get_version_number(xcodeproj: "AnswerGuard.xcodeproj")
    sh("python3 #{File.expand_path('../../scripts/verify_release.py', __dir__)} " \
       "--platform ios --version #{version}")
  end

  desc "Setup certificates and profiles"
  lane :setup do
    setup_ci if ENV["CI"] == "true"

    if ENV["MATCH_GIT_URL"]
      api_key = nil
      if ENV["APPSTORE_KEY_ID"] && ENV["APPSTORE_ISSUER_ID"]
        api_key = app_store_connect_api_key(
          key_id: ENV["APPSTORE_KEY_ID"],
          issuer_id: ENV["APPSTORE_ISSUER_ID"],
          key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['APPSTORE_KEY_ID']}.p8")
        )
      end

      # Distribution profiles for App Store export. Read-write when an API key
      # is present so match can generate any missing profile (calldirectory)
      # non-interactively; readonly otherwise. See the beta lane for the full
      # rationale.
      #
      # force_for_new_certificates is gated on MATCH_FORCE_NEW_CERT so it is
      # OFF for normal CI runs (which must not mint a new distribution cert
      # every build). It is flipped on for a ONE-SHOT regeneration run when the
      # stored distribution cert has been revoked on Apple's portal — match
      # then creates a single fresh cert via the API key and overwrites the
      # stale storage entry, without nuking other certs on the account.
      match(
        type: "appstore",
        app_identifier: [
          "com.igorganapolsky.answerguard",
          "com.igorganapolsky.answerguard.widget",
          "com.igorganapolsky.answerguard.calldirectory"
        ],
        readonly: api_key.nil?,
        force_for_new_certificates: ENV["MATCH_FORCE_NEW_CERT"] == "true",
        api_key: api_key
      )
    else
      UI.message("No MATCH_GIT_URL set - using Xcode automatic signing")
    end
  end
end
